# Copy to your shell or hosting dashboard. NEVER commit real keys.

# --- Gemini (persona + extraction). Without it: prepared replies + script + rules.
GEMINI_API_KEY=
# Optional: several keys to spread free-tier quota
# GEMINI_API_KEYS=key1,key2
# Model chains (tried in order; 404 retires a model, 429/503 cools it down)
# PAATTI_GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-flash-latest,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest
# PAATTI_GEMINI_EXTRACTOR_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash,gemini-flash-latest
PAATTI_GEMINI_THINKING_LEVEL=minimal
PAATTI_GEMINI_RPM=8
PAATTI_GEMINI_DAILY_CAP=600

# --- Sarvam AI (Tamil/Hindi speech). Needed for phone channels.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=kavitha
SARVAM_STT_MODE=translit
SARVAM_TTS_PACE=2.0
# Longest pause kept inside Paatti's speech, in ms (shorter = snappier; 0 = off)
PAATTI_TTS_MAX_GAP_MS=120
SARVAM_DAILY_CAP=2000

# --- Persona: paatti (Tamil), dadi (Hindi), ammamma (Telugu), ajji (Kannada), ammachi (Malayalam),
# thakuma (Bengali), aaji (Marathi), ba (Gujarati), bauji (Punjabi), thatha (Tamil, male),
# dadaji (Hindi, male), uncle (Goan English, male), or random (a different one every call)
PAATTI_PERSONA=paatti
# Demo script mode: rehearsed lines (docs/DEMO_SCRIPT.md) get instant pre-recorded replies
PAATTI_DEMO_MODE=1

# --- Public HTTPS URL (tunnel or Render) for QR codes and Twilio webhooks
PAATTI_PUBLIC_URL=

# --- Twilio real phone line (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PAATTI_OPERATOR_TOKEN=
PAATTI_OUTBOUND_ALLOWLIST=

# --- Optional: Claude instead of Gemini
# PAATTI_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# --- Server
PAATTI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PAATTI_SESSIONS_PER_MIN=30
PAATTI_MAX_TURNS=300
# PAATTI_DB=backend/data/paatti.db
# PAATTI_REPLY_CACHE_WRITE=0   # set 0 on a public deployment

# Phone-call realism: 8 kHz narrowband voice, phone AGC, G.711 grain and a quiet room tone. 0 = clean studio voice.
PAATTI_PHONE_LINE=1
# Room-tone loudness under her voice (dBFS, -90 to -30). -52 is a quiet room; -45 is a noisier line.
PAATTI_LINE_NOISE_DB=-52

# Grandparents that take calls (the others show as "Coming soon"). "all" turns all 12 on.
PAATTI_ACTIVE_PERSONAS=paatti,dadi
# Seconds between Sarvam requests while pre-recording the demo at startup (stays under the rate limit).
PAATTI_WARM_INTERVAL_S=3
