# Claude (persona + LLM extractor). Without it Paatti runs on scripted replies + the rule extractor.
ANTHROPIC_API_KEY=
PAATTI_PERSONA_MODEL=claude-opus-5-5
PAATTI_EXTRACTOR_MODEL=claude-opus-5-5
PAATTI_PERSONA_EFFORT=low
PAATTI_LLM_TIMEOUT=8

# Sarvam AI (Saaras STT, Bulbul TTS). Without it the browser's speech APIs are used.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=anushka
SARVAM_TTS_PACE=0.8

PAATTI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PAATTI_SESSIONS_PER_MIN=30
